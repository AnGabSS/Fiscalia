# ==============================================================================
# Fiscália — Variáveis de Ambiente (.env)
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# --- Banco de Dados PostgreSQL 16 + pgvector (Compatível com Supabase Cloud) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5435
POSTGRES_DB=fiscalia
POSTGRES_USER=fiscalia
POSTGRES_PASSWORD=fiscalia_secret_2026

# URL de conexão opcional (para uso com Supabase Cloud ou scripts externos)
DATABASE_URL=postgresql://fiscalia:fiscalia_secret_2026@localhost:5435/fiscalia

# --- Google Gemini API (Chave Única para LLM + Embeddings 768d) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TRIAGE=gemini-2.5-flash
GEMINI_MODEL_AGENT=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Canais de Notificação & Chat (Telegram & Slack) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_DEFAULT_CHANNEL=#alertas-tributarios

# --- Configuração do Orquestrador n8n ---
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=fiscalia-n8n-encryption-key-2026-change-me
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
